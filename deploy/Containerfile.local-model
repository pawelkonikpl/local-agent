# llama.cpp's own OpenAI-compatible server (CPU build): quantized GGUF weights + AVX2 kernels, so
# a 2B model runs faster in less RAM than the previous 0.5B did in float32 through transformers.
# Pinned to a build number -- chat-template / tool-call parsing changes between llama.cpp builds.
FROM ghcr.io/ggml-org/llama.cpp:server-b11176

# The base image runs as root; compose runs this as 10001 with a read-only rootfs, so the only
# writable place is the weights cache volume mounted below. Creating the mount point here, owned
# by 10001, makes podman initialise the named volume with that ownership.
RUN useradd -u 10001 -m -d /home/appuser appuser \
 && mkdir -p /home/appuser/.cache/huggingface \
 && chown -R 10001:10001 /home/appuser/.cache
USER 10001:10001

ENV HOME=/home/appuser \
    HF_HOME=/home/appuser/.cache/huggingface \
    LLAMA_CACHE=/home/appuser/.cache/huggingface/llama.cpp \
    LLAMA_ARG_PORT=8080 \
    LLAMA_ARG_UI=false
EXPOSE 8080
