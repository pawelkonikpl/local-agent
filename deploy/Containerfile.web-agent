FROM python:3.12-slim

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY services/web-agent/pyproject.toml services/web-agent/pyproject.toml
COPY libs/contracts/pyproject.toml libs/contracts/pyproject.toml
RUN uv sync --frozen --no-install-workspace --no-dev --package web-agent

# Headless shell only (no headful Chromium in the image); system libraries need root, so this
# runs before switching users. Browsers live outside $HOME, which is a tmpfs at runtime.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN .venv/bin/playwright install --with-deps --only-shell chromium

COPY services/web-agent/src services/web-agent/src
COPY libs/contracts/src libs/contracts/src
RUN uv sync --frozen --no-dev --package web-agent

RUN useradd -u 10001 -M -d /tmp appuser
USER 10001:10001
# The root filesystem is read-only; Chromium's profile, crash dumps and caches go to /tmp.
ENV HOME=/tmp
ENV PATH="/app/.venv/bin:${PATH}"
EXPOSE 8080

CMD ["uvicorn", "web_agent.main:app", "--host", "0.0.0.0", "--port", "8080", "--app-dir", "services/web-agent/src"]
