DATABASE_URL=postgresql+asyncpg://local_agent:local_agent@localhost:5432/local_agent
ENVIRONMENT=development
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# llm-proxy: real Anthropic key, known only to llm-proxy. Never stored in Postgres.
ANTHROPIC_API_KEY=

# Shared secret authorizing api -> llm-proxy calls (simple env token for this etap; a
# per-session signed token delivered via podman secret is Etap 4/5, once untrusted session
# containers need to talk to llm-proxy). Never stored in Postgres.
INTERNAL_PROXY_TOKEN=dev-proxy-secret-change-me

# api: where to reach llm-proxy. Compose sets this to http://llm-proxy:8080; when running both
# services directly on the host (not through podman-compose), point this at llm-proxy's local port.
LLM_PROXY_URL=http://localhost:8081

# api: models offered in the chat's model picker (JSON list); CHAT_MODEL is the default.
# CHAT_MODELS='["claude-sonnet-5", "gpt-6-sol", "local-model"]'

# llm-proxy: additional providers, opt-in. Requests are routed by the `model` field: "claude-*"
# -> Anthropic (above, always on), "local-model" -> LOCAL_MODEL_BASE_URL, anything else -> real
# OpenAI via OPENAI_API_KEY. `api` always talks to llm-proxy (LLM_PROXY_URL above) regardless of
# which provider ends up serving a given request.
# OPENAI_API_KEY enables the gpt-6-* models the chat picker offers (gpt-6-sol, gpt-6-astra,
# gpt-6-luna); without it llm-proxy answers them with 503.
OPENAI_API_KEY=
LOCAL_MODEL_BASE_URL=http://localhost:8090/v1

# local-model: CPU-only local LLM served by llama.cpp's llama-server (quantized GGUF), exposes an
# OpenAI-compatible /v1/chat/completions endpoint. Reached only through llm-proxy (never called
# directly by `api`) — reuses INTERNAL_PROXY_TOKEN above as its API key, no separate secret.
# Which GGUF to serve, as `<hf-repo>:<quant>`; compose passes it to both local-model and llm-proxy
# (LOCAL_MODEL_ID, the name recorded in token_usage). Must fit in the service's 6g mem_limit.
# LOCAL_MODEL_HF_REPO=unsloth/Qwen3.5-4B-GGUF:Q4_K_M

# web-agent: headless Chromium driven over CDP, behind the chat's `web_search` tool. `api` reaches
# it at WEB_AGENT_URL (compose sets http://web-agent:8080; compose doesn't publish its port, so for
# services run on the host, run web-agent on the host too and use http://localhost:8091) and
# authenticates with INTERNAL_PROXY_TOKEN above. Leave WEB_AGENT_URL unset to not offer the tool.
# WEB_AGENT_URL=http://localhost:8091
# Attach to an already running Chrome instead of the bundled one, e.g. Chrome started with
# --remote-debugging-port=9222 (useful for debugging; the model then drives that browser).
# WEB_AGENT_CDP_URL=http://localhost:9222
# Forward proxy for all of the browser's traffic, and hosts that skip it (compose sets both, to
# egress-proxy and searxng). Unset on the host: the browser connects directly.
# WEB_AGENT_PROXY_URL=http://egress-proxy:3128
# WEB_AGENT_PROXY_BYPASS=searxng
# Search engine web-agent's browser uses: "searxng" (compose default; our own SearXNG container)
# or "duckduckgo" (blocks headless browsers; only works with a visible browser or WEB_AGENT_CDP_URL).
# In compose the browser gets out only through egress-proxy's allowlist
# (deploy/egress-proxy/allowlist.txt), so "duckduckgo" there also needs html.duckduckgo.com listed.
# For the CLI on the host: WEB_AGENT_ENGINE=searxng WEB_AGENT_SEARXNG_URL=http://localhost:8092
# WEB_AGENT_ENGINE=searxng
# searxng: key signing its preference cookies; the instance is private, but set a real value anyway.
# SEARXNG_SECRET=
